###############################################################################
# Rubo — environment configuration
#
# Copy this file to `.env` and fill in the values you have. Everything below the
# "OPTIONAL / ROADMAP INTEGRATIONS" banner is commented out: uncomment and set a
# key only for the providers you want to use. Items marked [ACTIVE] are already
# wired into Rubo today; items marked [ROADMAP] are placeholders for upcoming
# connectors so you can collect the keys ahead of time.
###############################################################################

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Rubo defaults to FreeLLMAPI auto-routing (no per-provider key needed) as
# long as the local proxy is running. Set any of the keys below to switch
# providers from the in-app /model menu.

# FreeLLMAPI — local OpenAI-compatible proxy. [ACTIVE, DEFAULT]
# The proxy ignores the model id and auto-routes to a free model.
FREELLMAPI_API_KEY=your-freellmapi-api-key
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Hosted LLM providers (optional — pick whichever you have). [ACTIVE]
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (Local LLM). [ACTIVE]
OLLAMA_BASE_URL=http://127.0.0.1:11434

# minimax — primary default provider. [ACTIVE]
# OpenAI-compatible proxy that fronts minimax m2.5. The provider also exposes
# an Anthropic-compatible endpoint, but the OpenAI-compatible one is what the
# LangChain ChatOpenAI factory uses. Set MINIMAX_BASE_URL to the proxy URL and
# paste your key into MINIMAX_API_KEY in .env. Without these the agent falls
# back to the next available provider via /model.
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Persistent memory embeddings (semantic search). FreeLLMAPI is chat-only and
# CANNOT produce embeddings, so memory uses a separate embedder:
#   - Ollama (local, keyless, recommended): `ollama pull nomic-embed-text`, then
#     pin it in .rubo/settings.json -> {"memory":{"embeddingProvider":"ollama"}}
#   - or a hosted key: OPENAI_API_KEY (text-embedding-3-small) / GOOGLE_API_KEY (Gemini)
# With no embedder available, memory still works in keyword-only mode.
# 'auto' priority: OpenAI -> Gemini -> Ollama.

# =============================================================================
# MARKET DATA (ACTIVE)
# =============================================================================
# Financial Datasets — equities fundamentals, prices, filings, insider trades.
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Foreign-exchange rates (Frankfurter / ECB) and macro indicators (World Bank)
# are wired in and require NO API key.

# =============================================================================
# WEB SEARCH (ACTIVE — fallback chain: Exa -> Perplexity -> Tavily -> LangSearch)
# =============================================================================
EXASEARCH_API_KEY=your-exa-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key

# =============================================================================
# MESSAGING & SOCIAL (ACTIVE)
# =============================================================================
# X/Twitter — enables the x_search tool for public-sentiment research.
# How to get a bearer token:
#   1. Apply for a developer account at https://developer.x.com (Free tier works).
#   2. In the Developer Portal, create a Project + App.
#   3. Open the App -> "Keys and tokens" -> under "Authentication Tokens"
#      click "Generate" next to "Bearer Token" and copy it here.
X_BEARER_TOKEN=your-X-bearer-token

# Telegram bot — chat with Rubo over Telegram. Create a bot via @BotFather,
# then run `bun run gateway:telegram` to finish setup. This is the only gateway
# channel; WhatsApp was removed.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# =============================================================================
# OBSERVABILITY (ACTIVE)
# =============================================================================
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=rubo
LANGSMITH_TRACING=false


# =============================================================================
# RUNTIME PATHS (ACTIVE — all optional, sensible defaults)
# =============================================================================
# Where Rubo keeps memory, portfolio, scores, cron jobs and sessions.
# Defaults to ./.rubo when it exists, otherwise ~/.rubo. Set this when
# running as a service so a scheduled run does not get an empty brain.
# RUBO_HOME=/home/you/.rubo
# Gateway config file. Defaults to $RUBO_HOME/gateway.json.
# RUBO_GATEWAY_CONFIG=
# Session transcripts. Defaults to $RUBO_HOME/sessions.
# RUBO_SESSIONS_DIR=
# Verbose logging to the debug log.
# RUBO_DEBUG=1
# Run the Playwright browser visibly instead of headless.
# RUBO_BROWSER_HEADFUL=1
# The browser tool refuses to launch under Bun on Windows, where Playwright's
# launch handshake never completes. Run under Node (`npx tsx src/index.tsx`) to
# use it there, or set this to attempt the launch anyway.
# RUBO_BROWSER_FORCE=1

# SEC EDGAR asks every client to identify itself with a contactable address and
# throttles requests that do not. Without this, Rubo sends a placeholder.
# SEC_USER_AGENT=Your Name your@email.com

###############################################################################
# ADDITIONAL DATA PROVIDERS (ACTIVE)
#
# All of the keys below are wired in and used today. Rubo works without any
# of them - it falls back to the keyless tier (SEC EDGAR, Yahoo, Frankfurter/ECB,
# World Bank, BIS, Blockchain.com) - but each one it has widens coverage. Run
# `bun run health` to see exactly which tools are live for your key set.
###############################################################################

# ---- Equities / multi-asset market data -------------------------------------
# Alpha Vantage — commodities (WTI, Brent, gold) and multi-asset series. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Polygon.io — US stocks, options, FX, crypto snapshots. Paid tier for most endpoints. https://polygon.io
POLYGON_API_KEY=
# Finnhub — real-time quotes, company news, catalyst calendar, scoring inputs. https://finnhub.io
FINNHUB_API_KEY=
# Financial Modeling Prep — income statements, price targets, earnings surprises. https://site.financialmodelingprep.com
FMP_API_KEY=
# Twelve Data — global equities, FX, indices. https://twelvedata.com
TWELVE_DATA_API_KEY=
# Tiingo — EOD prices and fundamentals; a scoring input. https://www.tiingo.com
TIINGO_API_KEY=
# EOD Historical Data — non-US exchanges, powers get_global_stock. https://eodhd.com
EODHD_API_KEY=

# ---- Crypto markets ---------------------------------------------------------
# CoinGecko (Demo plan) — prices, global market cap, dominance. https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# CoinMarketCap — listings, quotes, global metrics. https://coinmarketcap.com/api
COINMARKETCAP_API_KEY=
# (Binance, Coinbase and Blockchain.com public endpoints need no key.)

# ---- Macro ------------------------------------------------------------------
# FRED — US Federal Reserve series: Fed funds, Treasury yields, CPI. Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# (ECB Statistical Data Warehouse, Bank of England, BIS and World Bank are keyless.)

# ---- News & sentiment -------------------------------------------------------
# NewsAPI — headlines across thousands of sources. https://newsapi.org
NEWSAPI_KEY=
# Marketaux — financial news with per-entity sentiment scores. https://www.marketaux.com
MARKETAUX_API_KEY=
# Benzinga — market-moving news and analyst ratings. https://www.benzinga.com/apis
BENZINGA_API_KEY=

# ---- Real estate (peripheral to equity research) ----------------------------
# RentCast — US rent and value estimates. https://www.rentcast.io
RENTCAST_API_KEY=
# RapidAPI — gateway for the Realtor listings endpoint. https://rapidapi.com
RAPIDAPI_KEY=

# ---- ISIN lookup -----------------------------------------------------------------
# OpenFIGI works without a key (25 requests a minute); a free key raises the limit.
# https://www.openfigi.com/api
OPENFIGI_API_KEY=

# ---- Judgement layer ------------------------------------------------------------
# TypeSafe (Jev) — dividend-cut, thesis and news-materiality probabilities.
# Without it those three tools are simply not offered. https://typesafe.ai
TYPESAFE_API_KEY=

# ---- Your locale ------------------------------------------------------------------
# Both can also be set with /setup, which takes precedence.
# IANA time zone for session ids and reminder times. Set it on a server: its clock
# is usually UTC. Empty = this machine's zone.
RUBO_TIMEZONE=
# Currency every portfolio and income amount is reported in. Empty = USD.
RUBO_BASE_CURRENCY=
