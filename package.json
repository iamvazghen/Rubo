{
  "name": "rubo-ts",
  "version": "1.1.0",
  "description": "Rubo - self-hosted financial research agent with deterministic 0-100 investment grading on two horizons.",
  "license": "MIT",
  "author": "iamvazghen",
  "repository": { "type": "git", "url": "git+https://github.com/iamvazghen/rubo.git" },
  "homepage": "https://github.com/iamvazghen/rubo#readme",
  "bugs": { "url": "https://github.com/iamvazghen/rubo/issues" },
  "keywords": ["finance", "investing", "ai-agent", "llm", "stocks", "etf", "valuation", "telegram-bot"],
  "engines": { "node": ">=20" },
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "rubo": "./src/index.tsx"
  },
  "scripts": {
    "start": "node --import tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "gateway": "tsx src/gateway/index.ts run",
    "gateway:telegram": "tsx src/gateway/index.ts telegram",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "health": "bun run src/evals/provider-health.ts",
    "health:stateful": "bun run src/evals/stateful-tools.ts",
    "behavioral": "bun run src/evals/behavioral.ts",
    "test:watch": "bun test --watch",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@langchain/exa": "^1.0.1",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.3.1",
    "@langchain/tavily": "^1.2.0",
    "@mariozechner/pi-tui": "^0.52.12",
    "axios": "^1.17.0",
    "better-sqlite3": "^12.8.0",
    "croner": "^9.1.0",
    "diff": "^8.0.4",
    "dotenv": "^17.3.1",
    "exa-js": "^2.10.1",
    "gray-matter": "^4.0.3",
    "langsmith": "^0.4.12",
    "lru-cache": "^11.5.1",
    "playwright": "^1.58.2",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
